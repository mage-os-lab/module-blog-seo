<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- A blog post page's article data, from which MageOS_Seo writes its BlogPosting. -->
    <type name="MageOS\Seo\Model\StructuredData\Provider\ArticleSchemaProvider">
        <arguments>
            <argument name="dataProviders" xsi:type="array">
                <item name="mageos_blog" xsi:type="object">MageOS\BlogSeo\Model\ArticleDataProvider</item>
            </argument>
        </arguments>
    </type>

</config>
